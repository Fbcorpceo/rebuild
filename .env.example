# ─── Transactional email (Resend) ────────────────────────────────
# Used for: customer confirmation email + the formatted internal
# lead alert that lands in your Gmail inbox. Sign up at resend.com,
# verify fbcorp.io (or keep using onboarding@resend.dev for now),
# paste the API key here.
RESEND_API_KEY=

# Where the internal "[NEW LEAD]" email lands.
# Set this to the Gmail address you want notifications in.
LEAD_INBOX=drew@fbcorp.io

# ─── Telegram bot notification ───────────────────────────────────
# 1. In Telegram, message @BotFather, run /newbot, copy the token.
# 2. Message your new bot once (anything), then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates — copy your
#    chat.id from the JSON.
# 3. Paste both values below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Customer SMS (Twilio) — optional ────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+13104998716

# ─── CRM / Zapier / Make webhook — optional ──────────────────────
CRM_WEBHOOK_URL=
